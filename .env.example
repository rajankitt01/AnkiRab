# ==========================================
# ANKIRAB.COM ENVIRONMENT CONFIGURATION
# ==========================================

# Server Configuration
PORT=4000
NODE_ENV=development
API_BASE_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ankirab?schema=public

# SQLite fallback for quick zero-setup local dev / CI without postgres daemon:
# DATABASE_URL=file:./dev.db

# JWT Secrets (Generate secure random 32+ character strings for production)
JWT_ACCESS_SECRET=ankirab_ultra_secure_access_secret_key_2026_dev_32chars
JWT_REFRESH_SECRET=ankirab_ultra_secure_refresh_secret_key_2026_dev_32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password Hashing
BCRYPT_SALT_ROUNDS=10

# External Metadata Providers (AniList, Kitsu, etc.)
ANILIST_API_URL=https://graphql.anilist.co
METADATA_CACHE_TTL_HOURS=24

# Video Providers
VIDEO_PROVIDER_DEFAULT=demo
VIDEO_STREAM_TOKEN_SECRET=ankirab_secure_stream_signature_token_2026

# Admin Bootstrap Credentials (Used during initial seed)
ADMIN_EMAIL=admin@ankirab.com
ADMIN_PASSWORD=AdminSecurePass123!
ADMIN_USERNAME=AdminAnkirab

# Frontend App Config
VITE_API_URL=http://localhost:4000/api
VITE_APP_NAME=ANKIRAB
